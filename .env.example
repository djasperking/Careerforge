# ---------------------------------------------------------------------------
# Career Forge (CF) — environment variables
# Copy to .env and fill in. NEVER commit .env. NEVER expose secret keys to the
# browser (only NEXT_PUBLIC_* vars reach the client).
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Career Forge"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_forge?schema=public"

# Auth.js / NextAuth
# Generate: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST=true

# Development-only bootstrap admin (used by prisma/seed.ts). Do NOT hard-code in source.
ADMIN_EMAIL="admin@careerforge.local"
ADMIN_PASSWORD="ChangeMe_Admin123!"
DEMO_CUSTOMER_EMAIL="customer@careerforge.local"
DEMO_CUSTOMER_PASSWORD="ChangeMe_User123!"

# AI provider (server-side only)
AI_PROVIDER=mock               # anthropic | openrouter | google | mock
ANTHROPIC_API_KEY=""           # for AI_PROVIDER=anthropic
GEMINI_API_KEY=""              # for AI_PROVIDER=google — from aistudio.google.com/apikey
GEMINI_MODEL="gemini-3.6-flash"
OPENROUTER_API_KEY=""          # for AI_PROVIDER=openrouter — Claude etc. without an Anthropic account (openrouter.ai/keys)
OPENROUTER_MODEL="anthropic/claude-sonnet-5"  # any slug from openrouter.ai/models
AI_MODEL="claude-sonnet-5"     # Anthropic model id (used only by AI_PROVIDER=anthropic)
AI_MAX_OUTPUT_TOKENS=2000

# Payments — Paystack (server-side secret + public key)
PAYMENT_PROVIDER=mock           # paystack | mock — set to paystack with real keys before launch
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""      # if unset, PAYSTACK_SECRET_KEY is used to verify signatures
DEFAULT_CURRENCY=NGN

# Email (SMTP or provider). Falls back to a console logger in development.
EMAIL_PROVIDER=console          # console | smtp
EMAIL_FROM="Career Forge <no-reply@careerforge.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# Object storage
# - local: writes to /public/uploads (dev only; not persistent on Vercel)
# - vercel-blob: used automatically when BLOB_READ_WRITE_TOKEN is present
#   (enable Blob storage on the Vercel project and it injects the token)
STORAGE_PROVIDER=local          # local | s3 | vercel-blob
BLOB_READ_WRITE_TOKEN=""
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL="http://localhost:3000/uploads"

# Security
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Weekly digest cron (Vercel Cron bearer token)
CRON_SECRET=

# Daily.co — auto-generates a video-call room when an instructor/coach leaves
# the meeting-link field blank when scheduling a cohort session or confirming
# a coaching booking. Get a key at https://dashboard.daily.co/developers.
# If unset, those flows just require a manually-pasted link, as before.
DAILY_API_KEY=
